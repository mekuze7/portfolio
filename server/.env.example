# SMTP Server Configuration
# Copy this file to .env and fill in your actual values

# ---------- SMTP Settings (Gmail Example) ----------
# For GMAIL: use smtp.gmail.com, port 465 (secure=true)
# You MUST use a Gmail App Password (NOT your regular password!)
# See: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mekuze7@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ---------- Recipient (where contact emails go) ----------
# If blank, defaults to SMTP_USER
RECIPIENT_EMAIL=mekuze7@gmail.com

# ---------- Server Port (optional) ----------
PORT=5000
